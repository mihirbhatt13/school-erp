# ==========================================
# OpenRouter LLM Configuration
# ==========================================
# Get your free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Free LLM models on OpenRouter:
# - meta-llama/llama-3.3-70b-instruct:free
# - google/gemini-2.0-flash-lite-preview-02-05:free
# - deepseek/deepseek-r1:free
# - qwen/qwen-2.5-7b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ==========================================
# Embedding Model Configuration
# ==========================================
# SentenceTransformers free local embedding model (384 dimensions)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ==========================================
# Qdrant Vector Store Configuration
# ==========================================
# QDRANT_MODE choices: 'local' (local disk), 'docker' (local Docker container), or 'cloud'
QDRANT_MODE=local

# Local mode storage path (used when QDRANT_MODE=local)
QDRANT_PATH=./qdrant_db

# Docker mode settings (used when QDRANT_MODE=docker)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Cloud mode settings (used when QDRANT_MODE=cloud)
QDRANT_URL=
QDRANT_API_KEY=

# Collection name for PDF vectors
COLLECTION_NAME=pdf_rag_documents
